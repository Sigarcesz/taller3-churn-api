[Unit]
Description=API FastAPI - prediccion de churn de clientes (Taller 3 MLOps EIA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/taller3-churn-api
Environment="PYTHONUNBUFFERED=1"
Environment="MODEL_PATH=models/pipeline_churn.joblib"
ExecStart=/home/ubuntu/taller3-churn-api/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
